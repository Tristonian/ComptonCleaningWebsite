# Copy to .env.local and fill in. .env.local is gitignored.
# Production/staging values are Worker secrets (`wrangler secret put NAME`), not this file.
# After setting a secret, confirm it is NON-EMPTY - an empty secret looks present.

APP_ENV=development
SITE_URL=http://localhost:3000

# Cloudflare (Sam's account; not a secret, but pin it so nothing deploys to the wrong one)
CLOUDFLARE_ACCOUNT_ID=f63f844d70738925fc7fb251893122cc

# Google OAuth (ADR 0003) - console.cloud.google.com, project "comptoncleaning"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. gmail.com / googlemail.com, dots and +tags are treated as equivalent.
ADMIN_ALLOWED_EMAILS=samueljcompton93@gmail.com,tristan.d.pointer@googlemail.com

# 32+ random bytes, base64url. Signs the short-lived OAuth state cookie.
SESSION_SECRET=

# Resend API key (sending access). Worker secret in staging/production (`wrangler secret put RESEND_API`).
RESEND_API=
# Who gets contact-form enquiries; comma-separated. Worker secret (the repo is public: keep it out of git).
ENQUIRY_TO=
# Optional sender override, e.g. onboarding@resend.dev before the domain is verified. Default: enquiry@comptoncleaning.co.uk
MAIL_FROM=
