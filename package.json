{
  "name": "compton-cleaning",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Marketing site and edit-anywhere admin for Compton Cleaning (window cleaning).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply compton-cleaning --local",
    "db:migrate:staging": "wrangler d1 migrations apply compton-cleaning-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply compton-cleaning --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
